---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" style="color-scheme: light dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — FMCamps Kitchen Sink</title>
    <link rel="stylesheet" href="/css/fmcamps.css" />
    <style>
      .ks-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 2rem 3rem;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-dark bg-fmc1">
      <a class="navbar-brand" href="/">FMCamps DS</a>
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/' ? 'active' : ''}`} href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/tokens/' ? 'active' : ''}`} href="/tokens/">Tokens</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/buttons/' ? 'active' : ''}`} href="/buttons/">Buttons</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/forms/' ? 'active' : ''}`} href="/forms/">Forms</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/tables/' ? 'active' : ''}`} href="/tables/">Tables</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/cards/' ? 'active' : ''}`} href="/cards/">Cards</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/modals/' ? 'active' : ''}`} href="/modals/">Modals</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/alerts/' ? 'active' : ''}`} href="/alerts/">Alerts</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/navigation/' ? 'active' : ''}`} href="/navigation/">Nav</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/feedback/' ? 'active' : ''}`} href="/feedback/">Feedback</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/media/' ? 'active' : ''}`} href="/media/">Media</a>
        </li>
        <li class="nav-item">
          <a class={`nav-link ${Astro.url.pathname === '/dark-theme/' ? 'active' : ''}`} href="/dark-theme/">Dark</a>
        </li>
      </ul>
    </nav>

    <div class="ks-container">
      <slot />
    </div>

    <footer class="text-center py-3" style="border-top: 1px solid var(--border-color, #dee2e6);">
      <small class="text-muted">FMCamps Design System — Bootstrap 4.6.2 fork — Kitchen Sink</small>
    </footer>
  </body>
</html>
