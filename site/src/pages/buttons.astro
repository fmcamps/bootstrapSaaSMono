---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base title="Buttons">
  <h1 class="mb-4">Buttons</h1>

  <Section title="Variantes principales" description="Botones con colores del brand via CSS custom properties">
    <div class="mb-3">
      <button type="button" class="btn btn-primary mr-2">Primary</button>
      <button type="button" class="btn btn-secondary mr-2">Secondary</button>
      <button type="button" class="btn btn-success mr-2">Success</button>
      <button type="button" class="btn btn-danger mr-2">Danger</button>
      <button type="button" class="btn btn-warning mr-2">Warning</button>
      <button type="button" class="btn btn-info mr-2">Info</button>
      <button type="button" class="btn btn-light mr-2">Light</button>
      <button type="button" class="btn btn-dark mr-2">Dark</button>
    </div>
  </Section>

  <Section title="Botones especiales FMCamps" description="btn-orange, btn-link con light-dark">
    <div class="mb-3">
      <button type="button" class="btn btn-orange mr-2">btn-orange</button>
      <button type="button" class="btn btn-link mr-2">btn-link</button>
    </div>
  </Section>

  <Section title="Outline" description="Variantes outline de Bootstrap">
    <div class="mb-3">
      <button type="button" class="btn btn-outline-primary mr-2">Outline Primary</button>
      <button type="button" class="btn btn-outline-secondary mr-2">Outline Secondary</button>
      <button type="button" class="btn btn-outline-success mr-2">Outline Success</button>
      <button type="button" class="btn btn-outline-danger mr-2">Outline Danger</button>
      <button type="button" class="btn btn-outline-warning mr-2">Outline Warning</button>
      <button type="button" class="btn btn-outline-info mr-2">Outline Info</button>
    </div>
  </Section>

  <Section title="Accept Button" description="CTA grande redondeado — .accept-button (1.5rem, 25px radius)">
    <div class="text-center mb-3">
      <button type="button" class="accept-button btn btn-primary">Guardar cambios</button>
    </div>
    <div class="text-center">
      <button type="button" class="accept-button btn btn-success">Confirmar acción</button>
    </div>
  </Section>

  <Section title="Botones circulares" description=".btn-circle y .btn-circle2 para íconos">
    <div class="mb-3">
      <button type="button" class="btn btn-circle mr-2"><i class="fa fa-pencil"></i></button>
      <button type="button" class="btn btn-circle mr-2"><i class="fa fa-trash"></i></button>
      <button type="button" class="btn btn-circle mr-2"><i class="fa fa-plus"></i></button>
      <button type="button" class="btn btn-circle mr-2"><i class="fa fa-search"></i></button>
    </div>
    <div class="mb-3">
      <button type="button" class="btn btn-circle2 mr-2"><i class="fa fa-pencil"></i></button>
      <button type="button" class="btn btn-circle2 mr-2"><i class="fa fa-trash"></i></button>
      <button type="button" class="btn btn-circle2 mr-2"><i class="fa fa-plus"></i></button>
      <button type="button" class="btn btn-circle2 mr-2"><i class="fa fa-search"></i></button>
    </div>
  </Section>

  <Section title="Grupo de botones" description=".btn-group con shadow y radius personalizado">
    <div class="btn-group mr-3" role="group">
      <button type="button" class="btn btn-primary">Izquierda</button>
      <button type="button" class="btn btn-primary">Centro</button>
      <button type="button" class="btn btn-primary">Derecha</button>
    </div>
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-outline-secondary">A</button>
      <button type="button" class="btn btn-outline-secondary">B</button>
      <button type="button" class="btn btn-outline-secondary">C</button>
    </div>
  </Section>

  <Section title="Botón Close" description="button.close con padding, radius y borde personalizado">
    <div class="p-3 mb-3" style="border:1px solid var(--border-color);border-radius:8px;position:relative;">
      <p>Contenido con botón close</p>
      <button type="button" class="close" style="position:absolute;top:10px;right:10px;">
        <span>&times;</span>
      </button>
    </div>
  </Section>

  <Section title="Estados" description="Disabled y active">
    <div class="mb-3">
      <button type="button" class="btn btn-primary mr-2" disabled>Disabled Primary</button>
      <button type="button" class="btn btn-success mr-2" disabled>Disabled Success</button>
      <button type="button" class="btn btn-danger mr-2" disabled>Disabled Danger</button>
    </div>
    <div class="mb-3">
      <button type="button" class="btn btn-primary active mr-2">Active Primary</button>
      <button type="button" class="btn btn-success active mr-2">Active Success</button>
    </div>
  </Section>

  <Section title="Tamaños" description="Bootstrap btn-lg y btn-sm">
    <div class="mb-3">
      <button type="button" class="btn btn-primary btn-lg mr-2">Large</button>
      <button type="button" class="btn btn-primary mr-2">Default</button>
      <button type="button" class="btn btn-primary btn-sm mr-2">Small</button>
    </div>
  </Section>
</Base>
