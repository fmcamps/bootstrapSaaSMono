---
import Base from '../layouts/Base.astro';
---

<Base title="Home">
  <div class="titulo py-3 mb-4">
    <h1 class="text-center text-white mb-0">FMCamps Design System</h1>
    <p class="text-center text-white-50 mb-0">Kitchen Sink — Bootstrap 4.6.2 fork</p>
  </div>

  <div class="row">
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Tokens</h5>
          <p class="card-text">Colores corporativos, tipografía, gradientes, blur, scrollbar.</p>
          <a href="/tokens/" class="btn btn-primary btn-sm">Ver tokens</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Buttons</h5>
          <p class="card-text">Variantes, tamaños, círculos, grupos, estados.</p>
          <a href="/buttons/" class="btn btn-primary btn-sm">Ver buttons</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Forms</h5>
          <p class="card-text">Inputs, switches, validación, readonly, animaciones.</p>
          <a href="/forms/" class="btn btn-primary btn-sm">Ver forms</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Tables</h5>
          <p class="card-text">Tablas básicas, striped, bordered, hover, transparente.</p>
          <a href="/tables/" class="btn btn-primary btn-sm">Ver tables</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Cards</h5>
          <p class="card-text">Cards, accordion, jumbotron.</p>
          <a href="/cards/" class="btn btn-primary btn-sm">Ver cards</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Modals</h5>
          <p class="card-text">Modales estáticos con headers, body, footer.</p>
          <a href="/modals/" class="btn btn-primary btn-sm">Ver modals</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Alerts</h5>
          <p class="card-text">Alertas por tipo: primary, info, danger, warning, success.</p>
          <a href="/alerts/" class="btn btn-primary btn-sm">Ver alerts</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Navigation</h5>
          <p class="card-text">Navbar, tabs, dropdowns, pagination.</p>
          <a href="/navigation/" class="btn btn-primary btn-sm">Ver navigation</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Feedback</h5>
          <p class="card-text">Toasts, diálogos, spinners, badges.</p>
          <a href="/feedback/" class="btn btn-primary btn-sm">Ver feedback</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Media</h5>
          <p class="card-text">List groups, imágenes, gestor de archivos.</p>
          <a href="/media/" class="btn btn-primary btn-sm">Ver media</a>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Dark Theme</h5>
          <p class="card-text">Comparativa light/dark, toggle de temas.</p>
          <a href="/dark-theme/" class="btn btn-primary btn-sm">Ver dark theme</a>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 text-muted">
    <small>
      <strong>Stack:</strong> Bootstrap 4.6.2 · dart-sass · Font Awesome 4.7.0 · RFS ·
      Pipeline: sass → autoprefixer → clean-css
    </small>
  </div>
</Base>
