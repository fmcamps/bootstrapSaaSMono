---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base title="Tokens">
  <h1 class="mb-4">Design Tokens</h1>

  <Section title="Colores corporativos" description="CSS custom properties del brand FMCamps">
    <div class="row">
      <div class="col-md-4 col-lg-2 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--cyan-fmc);border-radius:8px;" class="mb-2"></div>
        <code>--cyan-fmc</code>
      </div>
      <div class="col-md-4 col-lg-2 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--orange-fmc);border-radius:8px;" class="mb-2"></div>
        <code>--orange-fmc</code>
      </div>
      <div class="col-md-4 col-lg-2 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--danger-fmc);border-radius:8px;" class="mb-2"></div>
        <code>--danger-fmc</code>
      </div>
      <div class="col-md-4 col-lg-2 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--success-fmc);border-radius:8px;" class="mb-2"></div>
        <code>--success-fmc</code>
      </div>
      <div class="col-md-4 col-lg-2 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--warning-fmc);border-radius:8px;" class="mb-2"></div>
        <code>--warning-fmc</code>
      </div>
      <div class="col-md-4 col-lg-2 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--blue-fmc);border-radius:8px;" class="mb-2"></div>
        <code>--blue-fmc</code>
      </div>
    </div>
  </Section>

  <Section title="Colores de superficie" description="Variables para fondos, texto y bordes">
    <div class="row">
      <div class="col-md-3 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--light-bg);border:1px solid #ccc;border-radius:8px;" class="mb-2"></div>
        <code>--light-bg</code>
      </div>
      <div class="col-md-3 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--dark-bg);border-radius:8px;" class="mb-2"></div>
        <code>--dark-bg</code>
      </div>
      <div class="col-md-3 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--dark-bg2);border-radius:8px;" class="mb-2"></div>
        <code>--dark-bg2</code>
      </div>
      <div class="col-md-3 mb-3 text-center">
        <div style="width:100%;height:80px;background:var(--gris-oscuro);border-radius:8px;" class="mb-2"></div>
        <code>--gris-oscuro</code>
      </div>
    </div>
    <div class="row mt-2">
      <div class="col-md-4 mb-3">
        <div class="p-3 rounded" style="background:var(--light-bg);color:var(--light-color);border:1px solid var(--border-color);">
          <code>--light-color</code>: Texto sobre fondo claro
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="p-3 rounded" style="background:var(--dark-bg);color:var(--dark-color);">
          <code>--dark-color</code>: Texto sobre fondo oscuro
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="p-3 rounded" style="border:2px solid var(--border-color);color:var(--label-color);">
          <code>--label-color</code> / <code>--border-color</code>
        </div>
      </div>
    </div>
  </Section>

  <Section title="Tipografía" description="Estilos de texto del design system">
    <p><strong>Base:</strong> <code>html &#123; font-size: 14px &#125;</code></p>
    <div class="mb-3">
      <label>Label (font-weight: 300, 1.15rem, --label-color)</label>
    </div>
    <div class="mb-3">
      <span class="h6">H6 (font-weight: 400)</span>
    </div>
    <div class="mb-3">
      <p class="lead">Lead paragraph (1.25rem, font-weight: 400, line-height: 1.7)</p>
    </div>
    <div class="mb-3">
      <span class="help-block">Help block (font-size: 12px)</span>
    </div>
    <hr />
    <p><code>hr</code> — margen reducido (8px top/bottom)</p>
  </Section>

  <Section title="Gradientes" description="Clases de gradiente corporativas .bg-fmc1/2/3">
    <div class="row mb-3">
      <div class="col-md-4 mb-3">
        <div class="bg-fmc1 p-4 rounded text-white text-center">
          <strong>.bg-fmc1</strong><br/>30° dark blue → orange
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="bg-fmc2 p-4 rounded text-white text-center">
          <strong>.bg-fmc2</strong><br/>102° black → brown → teal
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="bg-fmc3 p-4 rounded text-white text-center">
          <strong>.bg-fmc3</strong><br/>88° orange → cyan → blue
        </div>
      </div>
    </div>

    <div class="mb-4">
      <div class="titulo">Texto con .titulo</div>
    </div>
    <div class="mb-4">
      <div class="tituloright">Texto con .tituloright</div>
      <div style="clear:both;"></div>
    </div>
  </Section>

  <Section title="Blur" description="Clases con backdrop-filter y sombras">
    <div class="row">
      <div class="col-md-4 mb-3">
        <div class="bg-fmc2 p-2 rounded">
          <div class="bg-black-blur p-3 rounded text-white text-center">
            <strong>.bg-black-blur</strong>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="bg-fmc1 p-2 rounded">
          <div class="bg-white-blur p-3 rounded text-center">
            <strong>.bg-white-blur</strong>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="bg-fmc3 p-2 rounded">
          <div class="bg-blur p-3 rounded text-white text-center">
            <strong>.bg-blur</strong>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section title="Scrollbar" description="Scrollbar personalizado (global en todos los elementos)">
    <div style="height:120px;overflow-y:scroll;border:1px solid var(--border-color);border-radius:4px;padding:1rem;">
      <p>Contenido largo para demostrar el scrollbar customizado.</p>
      <p>El thumb es azul (#006da3) y cambia a naranja (#fd8500) en hover.</p>
      <p>El track tiene fondo oscuro (#212529) con border-radius.</p>
      <p>Ancho: 12px.</p>
      <p>Más contenido para hacer scroll...</p>
      <p>Y un poco más.</p>
      <p>Suficiente para ver el scrollbar en acción.</p>
    </div>
  </Section>
</Base>
