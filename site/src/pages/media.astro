---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
---

<Base title="Media">
  <h1 class="mb-4 tw:mb-6">Media</h1>

  <Section title="List Group" description=".list-group-item con light-dark, hover con fondo cálido">
    <div class="row">
      <div class="col-md-6 mb-3 tw:mb-4">
        <ul class="list-group">
          <li class="list-group-item">Item básico</li>
          <li class="list-group-item">Segundo item</li>
          <li class="list-group-item">Tercer item</li>
        </ul>
      </div>
      <div class="col-md-6 mb-3 tw:mb-4">
        <div class="list-group">
          <a href="#" class="list-group-item list-group-item-action">Item con acción (hover)</a>
          <a href="#" class="list-group-item list-group-item-action">Segundo item acción</a>
          <a href="#" class="list-group-item list-group-item-action active">Item activo</a>
          <a href="#" class="list-group-item list-group-item-action disabled">Item deshabilitado</a>
        </div>
      </div>
    </div>
    <p class="text-muted"><small>Padding reducido: <code>0.25rem 1.25rem</code>. Hover en dark mode: <code>#351905</code> (marrón cálido).</small></p>
  </Section>

  <Section title="List Group con badges" description="Combinación list-group + badges">
    <div class="row">
      <div class="col-md-6 mb-3 tw:mb-4">
        <ul class="list-group">
          <li class="list-group-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center">
            Proyectos activos
            <span class="badge badge-primary badge-pill">14</span>
          </li>
          <li class="list-group-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center">
            Pendientes de revisión
            <span class="badge badge-orange badge-pill">5</span>
          </li>
          <li class="list-group-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center">
            Completados
            <span class="badge badge-success badge-pill">32</span>
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <Section title="Evidencia / Thumbnails" description=".efevidencia.thumbnail + .img-ef (aspect-ratio 1:1, contain)">
    <div class="row">
      <div class="col-6 col-md-3 mb-3 tw:mb-4">
        <div class="efevidencia thumbnail">
          <div class="img-ef" style="background:#ddd;display:flex;align-items:center;justify-content:center;">
            <i class="fa fa-image fa-3x" style="color:#999;"></i>
          </div>
          <small>evidencia-001.jpg</small>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3 tw:mb-4">
        <div class="efevidencia thumbnail">
          <div class="img-ef" style="background:#ddd;display:flex;align-items:center;justify-content:center;">
            <i class="fa fa-file-pdf-o fa-3x" style="color:#c00;"></i>
          </div>
          <small>reporte-Q1.pdf</small>
        </div>
      </div>
      <div class="col-6 col-md-3 mb-3 tw:mb-4">
        <div class="efevidencia thumbnail">
          <div class="img-ef" style="background:#ddd;display:flex;align-items:center;justify-content:center;">
            <i class="fa fa-file-excel-o fa-3x" style="color:#1d6f42;"></i>
          </div>
          <small>datos-2026.xlsx</small>
        </div>
      </div>
    </div>
    <p class="text-muted"><small>Thumbnails con fondo <code>#575757</code>, padding 8px, radius 6px. <code>.img-ef</code> fuerza aspect-ratio 1:1.</small></p>
  </Section>

  <Section title="Gestor de Archivos" description=".gestor-archivos — upload zone, progress bar, attached files">
    <div class="gestor-archivos">
      <div class="upload-zone mb-3 tw:mb-4">
        <div class="upload-zone-content">
          <i class="fa fa-cloud-upload fa-3x mb-2 tw:mb-2"></i>
          <h5>Arrastra archivos aquí</h5>
          <p class="upload-zone-info text-muted">o haz click para seleccionar archivos</p>
          <p class="upload-zone-info text-muted">Formatos: PDF, JPG, PNG, XLSX — Máx: 10MB</p>
        </div>
      </div>

      <div class="selected-files-list mb-3 tw:mb-4">
        <h6>Archivos seleccionados</h6>
        <div class="file-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center p-2 tw:p-2 mb-1 tw:mb-1">
          <span><i class="fa fa-file-pdf-o text-danger mr-2 tw:mr-2"></i> reporte-mensual.pdf <small class="text-muted">(2.3 MB)</small></span>
          <button class="btn btn-danger btn-sm"><i class="fa fa-times"></i></button>
        </div>
        <div class="file-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center p-2 tw:p-2 mb-1 tw:mb-1">
          <span><i class="fa fa-file-image-o text-primary mr-2 tw:mr-2"></i> foto-evidencia.jpg <small class="text-muted">(1.1 MB)</small></span>
          <button class="btn btn-danger btn-sm"><i class="fa fa-times"></i></button>
        </div>
      </div>

      <div class="global-progress mb-3 tw:mb-4">
        <h6><i class="fa fa-upload mr-1 tw:mr-1"></i> Progreso de subida</h6>
        <div class="progress" style="height:24px;">
          <div class="progress-bar" style="width:65%;">65%</div>
        </div>
      </div>

      <div class="attached-files-list">
        <h6><i class="fa fa-paperclip mr-1 tw:mr-1"></i> Archivos adjuntos (3)</h6>
        <div class="attached-file-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center p-2 tw:p-2 mb-1 tw:mb-1 rounded tw:rounded">
          <a href="#"><i class="fa fa-file-pdf-o mr-2 tw:mr-2"></i> contrato-2026.pdf</a>
          <button class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></button>
        </div>
        <div class="attached-file-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center p-2 tw:p-2 mb-1 tw:mb-1 rounded tw:rounded">
          <a href="#"><i class="fa fa-file-image-o mr-2 tw:mr-2"></i> plano-sitio.png</a>
          <button class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></button>
        </div>
        <div class="attached-file-item d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center p-2 tw:p-2 mb-1 tw:mb-1 rounded tw:rounded">
          <a href="#"><i class="fa fa-file-excel-o mr-2 tw:mr-2"></i> presupuesto.xlsx</a>
          <button class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></button>
        </div>
      </div>
    </div>
  </Section>
</Base>
